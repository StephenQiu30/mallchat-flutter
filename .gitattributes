# Normalize line endings for common files
* text=auto

# Source code
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.pbxproj text eol=lf

# Platform metadata
*.plist text
*.entitlements text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.apk binary
*.aab binary
*.xcarchive binary
*.dylib binary
*.so binary
*.dll binary
*.jar binary
*.aar binary
